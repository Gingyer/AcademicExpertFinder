{
  "name": "ai-milestone-builder-project",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -e .env -- concurrently -n backend,frontend -c cyan,green --kill-others-on-fail \"uvicorn app.main:app --port 8000 --reload\" \"npm --prefix frontend run dev\"",
    "build": "npm --prefix frontend run build",
    "start": "npm --prefix frontend run start",
    "lint": "npm --prefix frontend run lint",
    "typecheck": "npm --prefix frontend run typecheck",
    "review:codex": "bash ./review_with_codex.sh",
    "review:codex:uncommitted": "bash ./review_with_codex.sh --uncommitted",
    "demo:svg-character:dev": "npm --prefix frontend-test-output run dev",
    "demo:svg-character:build": "npm --prefix frontend-test-output run build",
    "demo:svg-character:preview": "npm --prefix frontend-test-output run preview"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "dotenv-cli": "^7.4.2"
  }
}
